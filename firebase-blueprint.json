{
  "entities": {
    "ScannedMessage": {
      "title": "Scanned Message",
      "description": "A message scanned by the system for potential scams.",
      "type": "object",
      "properties": {
        "content": { "type": "string", "description": "The raw text of the message." },
        "riskPercentage": { "type": "number", "description": "The calculated risk percentage (0-100)." },
        "reason": { "type": "string", "description": "The primary reason for the risk score." },
        "layersResults": { "type": "object", "description": "Detailed results from the 5-layer analysis." },
        "timestamp": { "type": "string", "format": "date-time", "description": "When the scan occurred." },
        "userId": { "type": "string", "description": "The ID of the user who scanned the message." }
      },
      "required": ["content", "riskPercentage", "reason", "timestamp", "userId"]
    },
    "OfficialChannel": {
      "title": "Official Channel",
      "description": "A verified official communication channel for DUT.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["email", "sms", "url"], "description": "The type of channel." },
        "value": { "type": "string", "description": "The verified value (e.g., @dut.ac.za)." },
        "description": { "type": "string", "description": "Description of the channel." }
      },
      "required": ["type", "value"]
    },
    "ScamReport": {
      "title": "Scam Report",
      "description": "A report of a potential scam submitted by a student.",
      "type": "object",
      "properties": {
        "content": { "type": "string", "description": "The scam content reported." },
        "reporterId": { "type": "string", "description": "The ID of the reporter." },
        "timestamp": { "type": "string", "format": "date-time", "description": "When the report was made." },
        "status": { "type": "string", "enum": ["pending", "verified", "dismissed"], "description": "Status of the report." }
      },
      "required": ["content", "reporterId", "timestamp", "status"]
    },
    "MaliciousNumber": {
      "title": "Malicious Number",
      "description": "Aggregate data for a phone number identified in scams.",
      "type": "object",
      "properties": {
        "number": { "type": "string", "description": "The E.164 normalized number." },
        "reportCount": { "type": "number", "description": "Number of times reported." },
        "severityScore": { "type": "number", "description": "Aggregated risk score." },
        "firstSeen": { "type": "string", "format": "date-time" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "linkedUserIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["number", "reportCount", "severityScore"]
    },
    "MaliciousDomain": {
      "title": "Malicious Domain",
      "description": "Forensics on domains found in scam messages.",
      "type": "object",
      "properties": {
        "domain": { "type": "string" },
        "brandSpoofing": { "type": "string", "description": "The brand being mimicked." },
        "age": { "type": "string" },
        "registrar": { "type": "string" },
        "reportCount": { "type": "number" },
        "firstSeen": { "type": "string", "format": "date-time" }
      },
      "required": ["domain", "reportCount"]
    },
    "ScamCampaign": {
      "title": "Scam Campaign",
      "description": "A cluster of similar messages representing a coordinated campaign.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "messageHash": { "type": "string" },
        "messageCount": { "type": "number" },
        "patternDetails": { "type": "string" },
        "associatedNumbers": { "type": "array", "items": { "type": "string" } },
        "associatedDomains": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["messageHash", "messageCount"]
    }
  },
  "firestore": {
    "/scannedMessages/{messageId}": {
      "schema": "ScannedMessage",
      "description": "Collection of scanned messages for students."
    },
    "/officialChannels/{channelId}": {
      "schema": "OfficialChannel",
      "description": "Collection of verified DUT official channels."
    },
    "/scamReports/{reportId}": {
      "schema": "ScamReport",
      "description": "Collection of student-submitted scam reports."
    },
    "/maliciousNumbers/{numberId}": {
      "schema": "MaliciousNumber",
      "description": "Global registry of scammer numbers."
    },
    "/maliciousDomains/{domainId}": {
      "schema": "MaliciousDomain",
      "description": "Global registry of scammer domains."
    },
    "/scamCampaigns/{campaignId}": {
      "schema": "ScamCampaign",
      "description": "Clusters of coordinated scam activities."
    }
  }
}
